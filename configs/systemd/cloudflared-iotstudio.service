[Unit]
Description=Cloudflare Tunnel for example.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/iotstudio.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
